# ═══════════════════════════════════════════════════════════════
# Conexão com a API Python (../python-api)
# ═══════════════════════════════════════════════════════════════
#
# SEM esta variável o cadastro/login roda em MODO DEMONSTRAÇÃO: a
# validação continua valendo, mas nada é enviado ao back-end e o fluxo
# segue direto para o dashboard.
#
# NÃO use o prefixo NEXT_PUBLIC_: esta URL é lida apenas no servidor
# (rotas /api/auth/*). O browser nunca fala com a API diretamente — ela
# não registra CORSMiddleware, e assim os tokens ficam em cookies
# httpOnly, fora do alcance de JavaScript.
APERIA_API_URL=http://localhost:8000

# OAuth do Google (opcional). Sem isto o botão apenas exibe um aviso.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Base para og:image / twitter:image. Na Vercel é preenchida
# automaticamente por VERCEL_PROJECT_PRODUCTION_URL.
# NEXT_PUBLIC_SITE_URL=https://aperia.exemplo.com
